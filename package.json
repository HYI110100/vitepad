{
  "name": "vitepad",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "vitepad": "./dist/bin/vitepad.js"
  },
  "scripts": {
    "dev":  "concurrently \"tsc -w\" \"tsc-alias -w\" \"npm link\"",
    "build": "tsc && tsc-alias"
  },
  "keywords": [
    "vite",
    "development",
    "server",
    "tool",
    "manager",
    "launchpad",
    "cli",
    "proxy",
    "vitepad",
    "vpad"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HYI110100/vitepad.git"
  },
  "homepage": "https://github.com/HYI110100/vitepad#readme",
  "author": "HYI110100",
  "license": "MIT",
  "description": "Quickly start and manage multiple local environments for front-end testing, with Vite and optional proxy",
  "engines": {
    "node": ">=14.18.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.1",
    "inquirer": "^12.9.3"
  }
}
